# =====================================================================
#  CRS — ombor boshqaruv tizimi / среда (Environment)
#  Nusxa ko'rish / Копировать:  cp .env.example .env
# =====================================================================

# --- 1) SUPABASE (PostgreSQL) — tavsiya etiladi ------------------------
# Supabase Dashboard → Project Settings → Database → Connection string
# (URI formatida, ?sslmode=require bilan)

SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# (ixtiyoriy — faqat Supabase REST API uchun; ushbu loyihada kerak emas)
# SUPABASE_KEY=eyJhbGciOi...

# --- 2) TURSO (libSQL) — alternativ -----------------------------------
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Sessiya kaliti (ixtiyoriy, lekin tavsiya etiladi) -----------------
# Uzun tasodifiy qator. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin paroli (yangi bazada yaratiladigan admin hisobi) -----------
ADMIN_PASSWORD=admin

# =====================================================================
#  MA'LUMOT (lokal ishga tushirish uchun ixtiyoriy)
# =====================================================================
# PORT=3000
# OMBOR_DATA_DIR=C:\Users\User\Desktop\fignya\data
