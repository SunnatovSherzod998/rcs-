# =====================================================================
#  CRS — ombor boshqaruv tizimi / среда (Environment)
#  Nusxa ko'rish / Копировать:  cp .env.example .env
# =====================================================================

# --- Vercel serverless uchun (Turso / libSQL bulut bazasi) -------------
# Turso'da bepul DB yaratish:  https://turso.tech  →  New Database
# Keyin:  turso db show <db-name>  →  URL va Token

TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-token-here

# --- Sessiya kaliti (ixtiyoriy, lekin tavsiya etiladi) -----------------
# Uzun tasodifiy qator. Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin paroli (yangi bazada yaratiladigan admin hisobi) -----------
ADMIN_PASSWORD=admin

# =====================================================================
#  MA'LUMOT (lokal ishga tushirish uchun ixtiyoriy)
# =====================================================================
# PORT=3000
# OMBOR_DATA_DIR=C:\Users\User\Desktop\fignya\data
