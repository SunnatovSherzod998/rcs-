{
  "name": "crs",
  "version": "1.1.0",
  "description": "1C uslubidagi katta omboralarni boshqaruv tizimi: 2D bino rejasi, xona-stellaj-joy, nomenklatura, kirim-chiqim, inventarizatsiya",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/check-frontend.js",
    "reset": "node scripts/reset-db.js --yes",
    "backup": "node scripts/backup.js",
    "seed": "node scripts/seed-demo.js",
    "map": "node scripts/build-map.js",
    "images": "node scripts/seed-images.js",
    "test": "node scripts/test-api.js && node scripts/test-map-flow.js && node scripts/test-plan.js && node scripts/test-password.js",
    "check": "node scripts/check-frontend.js && node scripts/check-i18n.js"
  },
  "keywords": [
    "warehouse",
    "inventory",
    "1c",
    "erp",
    "ombor",
    "wms",
    "2d-map"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.15.4",
    "pg": "^8.23.1"
  }
}
